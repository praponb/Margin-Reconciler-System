# Copy to .env and adjust. All values are optional.
# SQLite (default):
DATABASE_URL=sqlite:///./reconciler.db
# PostgreSQL (docker compose up -d):
# DATABASE_URL=postgresql+psycopg://reconciler:reconciler@localhost:5432/reconciler
VAT_RATE=0.07
LOCAL_TIMEZONE=Asia/Bangkok
API_BASE_URL=http://127.0.0.1:8000
DEFAULT_MERCHANT_ID=00000000-0000-0000-0000-000000000001
AUTO_MIGRATE=true
